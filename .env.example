# 通义千问 API Key
DASHSCOPE_API_KEY=your_api_key_here

# 企业微信 Webhook URL
WEBHOOK_URL=your_webhook_url_here

# GitHub Token（可选，用于创建 Gist）
GITHUB_TOKEN=your_github_token_here

# Wechat2RSS 实例域名（config.json 中的占位符 ${WECHAT2RSS_DOMAIN} 会替换为该值）
# 例如自建实例：wec.zeabur.app，或使用 wechat2rss.xlab.app
WECHAT2RSS_DOMAIN=wec.zeabur.app

# RSS Token（可选，config.json 中的占位符 ${RSS_TOKEN} 会替换为该值）
RSS_TOKEN=
