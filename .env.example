# ============ LLM 模型配置 ============

# API Key（必需）：OpenAI 兼容格式，各家服务商通用
LLM_API_KEY=your_api_key_here

# 服务商预设（可选）：dashscope / zhipu / openai / deepseek / moonshot
# 不填时默认 dashscope（阿里云百炼）
LLM_PROVIDER=dashscope

# 或直接指定 OpenAI 兼容端点（可选，优先级高于 LLM_PROVIDER）
# 适用于 SiliconFlow、OpenRouter、本地 vLLM/Ollama 等任意兼容服务
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 模型名称（可选，默认 qwen-plus；以服务商文档中的模型 ID 为准）
# 例如：glm-5.3-flash / glm-5.2 / qwen3.8-flash / gpt-5.6
WECHAT_MODEL=qwen-plus

# 兼容旧配置：仍支持 DASHSCOPE_API_KEY 变量（等价于 LLM_API_KEY + dashscope 预设）
# DASHSCOPE_API_KEY=your_api_key_here

# ============ 其他配置 ============

# 企业微信 Webhook URL（必需）
WEBHOOK_URL=your_webhook_url_here

# GitHub Token（可选，用于创建 Gist；不配置时降级为仅标题列表推送）
GITHUB_TOKEN=your_github_token_here

# Wechat2RSS 实例域名（config.json 中的占位符 ${WECHAT2RSS_DOMAIN} 会替换为该值）
WECHAT2RSS_DOMAIN=wec.zeabur.app

# RSS Token（可选，config.json 中的占位符 ${RSS_TOKEN} 会替换为该值）
RSS_TOKEN=
